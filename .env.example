# Copy to .env.local. Never commit secrets.

# Razorpay Standard Checkout (test keys start with rzp_test_)
# KEY_SECRET is server-only. Never put it in NEXT_PUBLIC_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Paddle Billing (live API host: api.paddle.com)
# Create the secret API key in Paddle > Developer tools > Authentication.
# Do not put pdl_live_apikey_... in git or in the client.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Set false only as an emergency kill switch. Checkout is live when the
# Paddle client token is present (see lib/paddle-catalog.ts).
NEXT_PUBLIC_PADDLE_CHECKOUT_ENABLED=true
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_2a71b76e9af63dc5cb7f9d44760
# Optional: skip the Paddle IP allowlist on Vercel previews.
# PADDLE_SKIP_IP_CHECK=true

# Supabase (service role is server-only; never expose it to the browser)
SUPABASE_URL=https://kxqykdxydhfglnubjghj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://kxqykdxydhfglnubjghj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt4cXlrZHh5ZGhmZ2xudWJqZ2hqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg1MjQ4MjQsImV4cCI6MjEwNDEwMDgyNH0.My3EGHfWl7XGHM2NaCWNosYExysJvC6cBDR20ULZ6R4
